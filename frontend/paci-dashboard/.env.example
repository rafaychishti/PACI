# No backend exists until Dashboard Phase 4 (SDD §2, ADR-0003), so there
# are no real environment variables to configure yet. This file exists to
# establish the pattern (VITE_-prefixed, typed in src/vite-env.d.ts) that
# Phase 4's API base URL and any future keys will follow.
#
# Copy to .env.local for any local overrides — .env.local is gitignored
# by the Vite default .gitignore already in this project.

# Example only — remove once a real flag is needed.
VITE_ENABLE_DEBUG_LOGGING=false
